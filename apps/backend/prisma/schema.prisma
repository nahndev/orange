generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Glossary, CommitJobConfig, CommitJob will be defined here.

model Dictionary {
  id                 String   @id @default(cuid())
  name               String
  description        String?
  defaultLanguageKey String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  languages DictionaryLanguage[]
  terms     DictionaryTerm[]
  sentences DictionarySentence[]

  @@map("dictionaries")
}

model DictionaryLanguage {
  id           String @id @default(cuid())
  dictionaryId String
  key          String
  country      String

  dictionary Dictionary @relation(fields: [dictionaryId], references: [id], onDelete: Cascade)

  @@unique([dictionaryId, key])
  @@map("dictionary_languages")
}

model DictionaryTerm {
  id           String   @id @default(cuid())
  dictionaryId String
  key          String
  description  String?
  values       Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  dictionary Dictionary @relation(fields: [dictionaryId], references: [id], onDelete: Cascade)

  @@unique([dictionaryId, key])
  @@map("dictionary_terms")
}

model DictionarySentence {
  id           String   @id @default(cuid())
  dictionaryId String
  values       Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  dictionary Dictionary @relation(fields: [dictionaryId], references: [id], onDelete: Cascade)

  @@map("dictionary_sentences")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account?

  @@map("users")
}

model Account {
  id           String   @id @default(cuid())
  userId       String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}
