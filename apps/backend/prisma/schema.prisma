generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Glossary will be defined here.

model Dictionary {
  id                 String   @id @default(cuid())
  name               String
  description        String?
  defaultLanguageKey String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  languages DictionaryLanguage[]
  terms     DictionaryTerm[]
  sentences DictionarySentence[]
  commitJobConfigs CommitJobConfig[]

  @@map("dictionaries")
}

model DictionaryLanguage {
  id           String @id @default(cuid())
  dictionaryId String
  key          String
  country      String

  dictionary Dictionary @relation(fields: [dictionaryId], references: [id], onDelete: Cascade)

  @@unique([dictionaryId, key])
  @@map("dictionary_languages")
}

model DictionaryTerm {
  id           String   @id @default(cuid())
  dictionaryId String
  key          String
  description  String?
  values       Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  dictionary Dictionary @relation(fields: [dictionaryId], references: [id], onDelete: Cascade)

  @@unique([dictionaryId, key])
  @@map("dictionary_terms")
}

model DictionarySentence {
  id           String   @id @default(cuid())
  dictionaryId String
  values       Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  dictionary Dictionary @relation(fields: [dictionaryId], references: [id], onDelete: Cascade)

  @@map("dictionary_sentences")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  githubOwner          String?
  githubRepo           String?
  githubBranch         String?
  githubTokenEncrypted String?

  account Account?
  commitJobConfigs CommitJobConfig[]

  @@map("users")
}

model Account {
  id           String   @id @default(cuid())
  userId       String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

enum CommitJobTrigger {
  SENTENCE_CHANGED
}

enum CommitJobStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

model CommitJobConfig {
  id               String           @id @default(cuid())
  userId           String
  dictionaryId     String
  name             String
  trigger          CommitJobTrigger @default(SENTENCE_CHANGED)
  filePathTemplate String           @default("locales/{language}.json")
  enabled          Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  dictionary Dictionary  @relation(fields: [dictionaryId], references: [id], onDelete: Cascade)
  jobs       CommitJob[]

  @@index([dictionaryId, trigger, enabled])
  @@map("commit_job_configs")
}

model CommitJob {
  id                  String          @id @default(cuid())
  configId            String
  status              CommitJobStatus @default(RUNNING)
  branch              String?
  commitSha           String?
  changeRequestNumber Int?
  changeRequestUrl    String?
  error               String?
  createdAt           DateTime        @default(now())
  finishedAt          DateTime?

  config CommitJobConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([configId, createdAt])
  @@map("commit_jobs")
}
